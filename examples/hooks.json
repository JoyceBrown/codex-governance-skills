{
  "description": "Automatic durable-context recovery, compaction verification, and write guards for project ledgers.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%CODEX_HOME%\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "commandWindows": "py -3 \"%CODEX_HOME%\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Restoring durable task context",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%CODEX_HOME%\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "commandWindows": "py -3 \"%CODEX_HOME%\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Validating durable context before compaction"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%CODEX_HOME%\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "commandWindows": "py -3 \"%CODEX_HOME%\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Checking durable context after compaction"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%CODEX_HOME%\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "commandWindows": "py -3 \"%CODEX_HOME%\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%CODEX_HOME%\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "commandWindows": "py -3 \"%CODEX_HOME%\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
