{
  "description": "Automatic durable-context recovery, compaction verification, and write guards for project ledgers.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%USERPROFILE%\\.codex\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Restoring durable task context",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%USERPROFILE%\\.codex\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Validating durable context before compaction"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%USERPROFILE%\\.codex\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Checking durable context after compaction"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%USERPROFILE%\\.codex\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Routing durable task changes",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:Bash|apply_patch|Edit|Write|.*(?:click|type|input|upload|navigate|new_tab|close|cookies_set|evaluate|exec|mouse|mouse_drag|window_activate|window_move|window_resize|clipboard_write|clipboard_clean|send|create|update|delete|remove|rename|install|add|computer_use))$",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%USERPROFILE%\\.codex\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Checking durable context before writing"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%USERPROFILE%\\.codex\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\skills\\durable-context\\scripts\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Checking durable task state"
          }
        ]
      }
    ]
  }
}
