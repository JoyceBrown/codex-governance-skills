{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-governance-skills:hcr:hcr-epistemic-record.schema.json",
  "title": "HCR Epistemic Record",
  "type": "object",
  "required": [
    "claim",
    "epistemic_status"
  ],
  "properties": {
    "claim": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 4096
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "OBSERVATION",
        "FACT",
        "INFERENCE",
        "HYPOTHESIS",
        "PREDICTION",
        "UNKNOWN"
      ],
      "maxLength": 256
    },
    "governance_status": {
      "type": "string",
      "readOnly": true,
      "description": "Read-only opaque status copied from the authority identified by governance_reference; HCR never assigns or promotes it.",
      "maxLength": 256
    },
    "governance_reference": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 256
    },
    "source_type": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 256
    },
    "source_reference": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 256
    },
    "scope": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 256
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "maxLength": 256
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "contradicting_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "maxLength": 256
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "last_verified": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "maxLength": 64
    },
    "applicability_boundary": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 256
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "epistemic_status": {
            "const": "FACT"
          }
        },
        "required": [
          "epistemic_status"
        ]
      },
      "then": {
        "required": [
          "source_type",
          "source_reference",
          "scope",
          "supporting_evidence",
          "last_verified"
        ],
        "properties": {
          "source_type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 256
          },
          "source_reference": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 256
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 256
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 256
            },
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 100
          },
          "last_verified": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "governance_status"
        ]
      },
      "then": {
        "required": [
          "governance_reference"
        ]
      }
    }
  ]
}
