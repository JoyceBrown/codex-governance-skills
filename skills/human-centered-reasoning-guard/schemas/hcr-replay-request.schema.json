{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-governance-skills:hcr:hcr-replay-request.schema.json",
  "title": "HCR Replay Request",
  "type": "object",
  "required": [
    "why",
    "what",
    "project_id",
    "environment_scope",
    "experience_nodes",
    "constraints"
  ],
  "properties": {
    "why": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 4096
    },
    "what": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 4096
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 256
    },
    "environment_scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 256
    },
    "runtime_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 256
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "maxLength": 256
      },
      "uniqueItems": true,
      "description": "Current constraints are explicit; [] means none. They must match the recorded applicability contract.",
      "maxItems": 100
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "maxLength": 256
      },
      "uniqueItems": true,
      "description": "Omitted is unknown and cannot match a dependency-bound experience; [] explicitly means no dependencies.",
      "maxItems": 100
    },
    "experience_nodes": {
      "type": "array",
      "items": {
        "$ref": "hcr-experience-node.schema.json"
      },
      "maxItems": 1000
    },
    "strategy": {
      "$ref": "hcr-strategy.schema.json"
    }
  },
  "additionalProperties": false
}
