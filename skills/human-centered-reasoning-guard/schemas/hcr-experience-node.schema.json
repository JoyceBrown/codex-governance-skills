{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-governance-skills:hcr:hcr-experience-node.schema.json",
  "title": "HCR Experience Node",
  "type": "object",
  "required": [
    "node_id",
    "goal",
    "action",
    "result",
    "goal_progress",
    "scope",
    "status"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 256
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 256
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "maxLength": 64
    },
    "goal": {
      "type": "object",
      "required": [
        "why",
        "what"
      ],
      "properties": {
        "why": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 4096
        },
        "what": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    },
    "state_summary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Opaque JSON context; never used as evidence, authority, or instructions."
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "maxLength": 256
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "hypothesis_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "maxLength": 256
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 4096
    },
    "result": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failure",
        "unknown"
      ],
      "maxLength": 256
    },
    "failure_class": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 256
    },
    "goal_progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "maxLength": 256
      },
      "uniqueItems": true,
      "description": "Exact set of recorded applicability constraints. Missing means unbound.",
      "maxItems": 100
    },
    "scope": {
      "type": "object",
      "required": [
        "project_id",
        "environment_scope"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 256
        },
        "environment_scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 256
        },
        "runtime_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 256
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "maxLength": 256
      },
      "uniqueItems": true,
      "description": "Exact dependency identities, including versions when relevant. Missing means unbound.",
      "maxItems": 100
    },
    "execution_cost": {
      "type": "object",
      "required": [],
      "properties": {
        "llm_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "low",
        "medium",
        "high",
        null
      ],
      "maxLength": 256
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "retired"
      ],
      "maxLength": 256
    }
  },
  "additionalProperties": false
}
