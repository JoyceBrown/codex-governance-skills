{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-governance-skills:hcr:hcr-replay-result.schema.json",
  "title": "HCR Replay Result",
  "type": "object",
  "required": [
    "replay_version",
    "llm_calls",
    "candidates",
    "paths",
    "recommended",
    "historical_boundary",
    "status",
    "next_action",
    "recommendation_kind",
    "execution_authorized",
    "current_truth_established"
  ],
  "properties": {
    "replay_version": {
      "type": "string",
      "const": "cre-v1",
      "maxLength": 256
    },
    "llm_calls": {
      "type": "integer",
      "const": 0
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "maxItems": 1000
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "goal_progress",
          "cost_proxy",
          "utility",
          "early_stopped",
          "depth_truncated"
        ],
        "properties": {
          "path": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 256
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "goal_progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "cost_proxy": {
            "type": "number",
            "minimum": 0
          },
          "utility": {
            "type": "number"
          },
          "early_stopped": {
            "type": "boolean"
          },
          "depth_truncated": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "recommended": {
      "anyOf": [
        {
          "$ref": "#/$defs/candidate"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATES_FOUND",
        "NO_APPLICABLE_EXPERIENCE"
      ],
      "maxLength": 256
    },
    "next_action": {
      "type": "string",
      "enum": [
        "VERIFY_CANDIDATE",
        "REASON_OR_COLLECT_EVIDENCE"
      ],
      "maxLength": 256
    },
    "recommendation_kind": {
      "type": "string",
      "const": "historical_candidate",
      "maxLength": 256
    },
    "execution_authorized": {
      "type": "boolean",
      "const": false
    },
    "current_truth_established": {
      "type": "boolean",
      "const": false
    },
    "historical_boundary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 4096
    }
  },
  "additionalProperties": false,
  "$defs": {
    "candidate": {
      "type": "object",
      "required": [
        "node_id",
        "action",
        "result",
        "goal_progress",
        "evidence_count",
        "cost_proxy",
        "risk",
        "scope_match",
        "utility"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 256
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 4096
        },
        "result": {
          "type": "string",
          "enum": [
            "success",
            "partial",
            "failure",
            "unknown"
          ],
          "maxLength": 256
        },
        "goal_progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "cost_proxy": {
          "type": "number",
          "minimum": 0
        },
        "risk": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scope_match": {
          "type": "boolean",
          "const": true
        },
        "utility": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recommended": {
            "type": "null"
          }
        },
        "required": [
          "recommended"
        ]
      },
      "then": {
        "properties": {
          "next_action": {
            "const": "REASON_OR_COLLECT_EVIDENCE"
          }
        }
      },
      "else": {
        "properties": {
          "next_action": {
            "const": "VERIFY_CANDIDATE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "candidates": {
            "maxItems": 0
          }
        },
        "required": [
          "candidates"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "NO_APPLICABLE_EXPERIENCE"
          },
          "recommended": {
            "type": "null"
          },
          "paths": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "status": {
            "const": "CANDIDATES_FOUND"
          }
        }
      }
    }
  ]
}
